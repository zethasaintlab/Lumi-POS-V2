# --- Server ---
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://lumi_app:CHANGEME@localhost:5432/lumi
# WAJIB: user aplikasi TIDAK BOLEH superuser dan TIDAK BOLEH owner tabel (invariant #8)
DATABASE_MIGRATION_URL=postgres://lumi_owner:CHANGEME@localhost:5432/lumi

# --- Tenancy & deployment ---
TENANT_MODE=multi          # multi | single
LICENSE=cloud              # cloud | path ke file lisensi bertandatangan
TELEMETRY=full             # full | minimal | off

# --- Sync ---
POWERSYNC_URL=http://localhost:8080
POWERSYNC_TOKEN=

# --- Payment ---
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_ENV=sandbox
