# --- Server ---
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://lumi_app:CHANGEME@localhost:5432/lumi
# WAJIB: user aplikasi TIDAK BOLEH superuser dan TIDAK BOLEH owner tabel (invariant #8)
DATABASE_MIGRATION_URL=postgres://lumi_owner:CHANGEME@localhost:5432/lumi
# Superuser, HANYA untuk db/bootstrap.js (buat role + database). Tidak pernah dipakai aplikasi/migrasi.
DATABASE_ADMIN_URL=postgres://postgres:CHANGEME@localhost:5432/postgres

# --- Tenancy & deployment ---
TENANT_MODE=multi          # multi | single
LICENSE=cloud              # cloud | path ke file lisensi bertandatangan
TELEMETRY=full             # full | minimal | off

# --- Sync ---
POWERSYNC_URL=http://localhost:8080
POWERSYNC_TOKEN=

# --- Payment ---
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_ENV=sandbox

# --- CORS (invariant #5: daftar dari env, tidak pernah dari kode) ---
# Kosong = tidak ada origin yang diizinkan. `*` tidak pernah dijawab.
#
# ⛔ KETIGA aplikasi harus ada di sini, dan port-nya bukan yang ditebak.
# 1420 = apps/kasir · 1422 = apps/backoffice · 1423 = apps/hp.
# Port 1421 TIDAK dipakai aplikasi mana pun — ia HMR Tauri milik kasir, dan
# menuliskannya di sini mengizinkan origin yang tidak ada sambil membiarkan
# kasir tetap diblokir.
#
# Origin yang hilang dari daftar ini menghasilkan kegagalan yang TIDAK
# menyebut CORS di layar mana pun: aplikasi memuat dengan benar, lalu login
# gagal seperti server mati atau kata sandi salah. Ketiga port ditambahkan
# bersama karena yang lahir belakangan (apps/hp) terlewat justru dengan cara
# itu.
CORS_ORIGINS=http://localhost:1420,http://localhost:1422,http://localhost:1423

# --- Batas laju pendaftaran (F5) ---
# HANYA POST /tenants — satu-satunya endpoint tanpa autentikasi. Store
# in-memory (research/03: tanpa Redis di v1), jadi hitungannya per-proses.
TENANT_REGISTRATION_RATE_MAX=5
TENANT_REGISTRATION_RATE_WINDOW=15 minutes

# --- Token sinkronisasi perangkat (FR-F12) ---
# PEM kunci privat RSA. Kosong = endpoint token menjawab 503.
POWERSYNC_JWT_PRIVATE_KEY=

# --- Back-office (apps/backoffice, dibaca Vite saat build) ---
VITE_API_URL=http://localhost:3000

# --- Kasir (apps/kasir, dibaca Vite saat build) ---
# ⛔ Telemetri KLIEN. Variabel yang TIDAK DISET berarti `off`, bukan `full`:
# pemasangan on-premise yang lupa menyetelnya tidak boleh MENGUMPULKAN data
# tanpa ada yang menyetujuinya, sementara SaaS yang lupa hanya menghasilkan
# metrik kosong — dan kosong itu terlihat. `ARCH:262`.
VITE_TELEMETRY=full        # full | minimal | off
# Versi yang dilaporkan bersama metrik. `ARCH:302` memakai crash rate PER
# VERSI sebagai gate rollout bertahap.
VITE_APP_VERSION=0.0.0
